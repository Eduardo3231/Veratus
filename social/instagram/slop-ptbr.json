  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[ãa]o [ée] (?:s[óo]|apenas) [^.!?\\n]{2,60}[,.] [ée]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a coisa que você quer dizer. Corte a metade de preparação."
    },
    {
      "id": "mais-que",
      "regex": "(?i)\\bmais (?:do )?que (?:um|uma) [^.!?\\n]{2,40}[,.:] (?:[ée] )?(?:um|uma)\\b",
      "name": "\"Mais que um X, um Y\"",
      "fix": "Fale do objeto como ele é."
    },
    {
      "id": "trio",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Trio de adjetivos",
      "fix": "Fique com o adjetivo mais concreto."
    },
    {
      "id": "pergunta-retorica",
      "regex": "(?m)^(?:Sabe|Já pensou|Você sabia)[^?\\n]{0,80}\\?",
      "name": "Pergunta retórica de abertura",
      "fix": "Comece pelo fato ou pela peça."
    }
