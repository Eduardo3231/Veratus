FACEBOOK_MESSAGING_ENABLED=false
# Feed CSV do catálogo da Meta em /feeds/meta-catalog.csv (só peças prontas)
META_CATALOG_FEED_ENABLED=false
# Leitura de volta do catálogo na Meta (GET /{META_CATALOG_ID}/products; diferença
# vira conflito de sincronização). Token META_ACCESS_TOKEN com catalog_management.
META_CATALOG_READBACK_ENABLED=false
MERCADO_LIVRE_ANSWERS_ENABLED=false
# Leitura do envio (GET /shipments/{id}: status e rastreio) e etiqueta do Mercado Envios
MERCADO_LIVRE_SYNC_ENABLED=false
MERCADO_LIVRE_LABELS_ENABLED=false
MERCADO_LIVRE_SELLER_ID=
# Agendador social: publica só item APPROVED; desligado = prévia sem chamar a Meta
SOCIAL_PUBLISH_ENABLED=false
# Métricas do agendador (Graph API, só leitura); desligado = prévia sem rede
SOCIAL_INSIGHTS_ENABLED=false
# Triagem de comentários: SHADOW só rascunha; SUPERVISED envia o que o fundador aprova
SOCIAL_COMMENTS_MODE=SHADOW
# Comentários da Página do Facebook (campo feed) entram na triagem
FACEBOOK_COMMENTS_ENABLED=false
META_PAGE_ID=
# CEP no fechamento (BrasilAPI, ViaCEP de reserva): só o CEP sai, volta cidade e UF
CEP_LOOKUP_ENABLED=false
# Chatwoot: caixa única do fundador (espelha as conversas; resposta dele sai pelo canal)
CHATWOOT_SYNC_ENABLED=false
